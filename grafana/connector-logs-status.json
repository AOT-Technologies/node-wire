{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "node-wire connector calls: counts, success and the error taxonomy from audit logs (exact), latency from metrics, logs by trace_id",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Tool calls",
      "description": "Connector runs in the time range, from each run's audit log line (exact at any volume).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | action=~\"${action:regex}\" | scope_name=\"runtime.base_connector\" | audit_event=~\"invocation_success|invocation_failure|invocation_validation_failure|policy_denial\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Success rate",
      "description": "Connector runs that succeeded.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(sum(count_over_time({service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | action=~\"${action:regex}\" | scope_name=\"runtime.base_connector\" | audit_event=\"invocation_success\" [$__range])) or vector(0)) / sum(count_over_time({service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | action=~\"${action:regex}\" | scope_name=\"runtime.base_connector\" | audit_event=~\"invocation_success|invocation_failure|invocation_validation_failure|policy_denial\" [$__range])) * 100",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Rejected before running",
      "description": "Calls that never reached the connector: invalid arguments, no tenant, unknown config, bad proxy secret (audit_event invocation_rejected / invocation_validation_failure).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | audit_event=~\"invocation_rejected|invocation_validation_failure\" | scope_name!=\"runtime.base_connector\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "95th percentile connector run time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "\u2013",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(connector_duration_ms_milliseconds_bucket{service_name=~\"${service:regex}\",connector_id=~\"${connector:regex}\",connector_action=~\"${action:regex}\"}[$__range])))",
          "instant": true,
          "range": false
        }
      ],
      "id": 5
    },
    {
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": [],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Calls per minute",
      "description": "Successful runs, failed runs by error category, and calls rejected before the connector ran.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rejected before running"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | action=~\"${action:regex}\" | scope_name=\"runtime.base_connector\" | audit_event=\"invocation_success\" [$__interval]))",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "ok"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (error_category) (count_over_time({service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | action=~\"${action:regex}\" | scope_name=\"runtime.base_connector\" | audit_event=~\"invocation_failure|invocation_validation_failure|policy_denial\" [$__interval]))",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "{{error_category}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | audit_event=~\"invocation_rejected|invocation_validation_failure\" | scope_name!=\"runtime.base_connector\" [$__interval]))",
          "queryType": "range",
          "instant": false,
          "range": true,
          "legendFormat": "rejected before running"
        }
      ],
      "id": 7,
      "interval": "1m"
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(connector_duration_ms_milliseconds_bucket{service_name=~\"${service:regex}\",connector_id=~\"${connector:regex}\",connector_action=~\"${action:regex}\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(connector_duration_ms_milliseconds_bucket{service_name=~\"${service:regex}\",connector_id=~\"${connector:regex}\",connector_action=~\"${action:regex}\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "id": 8
    },
    {
      "type": "row",
      "title": "Errors",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": [],
      "id": 9
    },
    {
      "type": "table",
      "title": "Failed calls by error code",
      "description": "One row per error code: failures inside the connector (invocation_failure) and before it (invocation_rejected, invocation_validation_failure). Filter the logs below by a trace_id from the error text.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
          "expr": "sum by (error_code, error_category, audit_event, service_name) (count_over_time({service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | error_code=~\".+\" | audit_event=~\"invocation_failure|invocation_rejected|invocation_validation_failure\" [$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Calls",
              "Value #A": "Calls",
              "error_code": "Error code",
              "error_category": "Category",
              "audit_event": "Where",
              "service_name": "Service"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Calls",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 10
    },
    {
      "type": "piechart",
      "title": "Failures by category",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 16
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "{{error_category}}",
          "expr": "sum by (error_category) (count_over_time({service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | error_category=~\".+\" | audit_event=~\"invocation_failure|invocation_rejected|invocation_validation_failure\" [$__range]))"
        }
      ],
      "id": 11
    },
    {
      "type": "row",
      "title": "Per tool",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": [],
      "id": 12
    },
    {
      "type": "table",
      "title": "Runs by tool",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name, connector_id, action, audit_event) (count_over_time({service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | action=~\"${action:regex}\" | scope_name=\"runtime.base_connector\" | audit_event=~\"invocation_success|invocation_failure|invocation_validation_failure|policy_denial\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service_name": "Service",
              "connector_id": "Connector",
              "action": "Action",
              "audit_event": "Outcome",
              "Value": "Runs"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Runs",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "id": 13
    },
    {
      "type": "bargauge",
      "title": "p95 latency by tool",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 25
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "legendFormat": "{{connector_id}} {{connector_action}}",
          "expr": "histogram_quantile(0.95, sum by (connector_id, connector_action, le) (increase(connector_duration_ms_milliseconds_bucket{service_name=~\"${service:regex}\",connector_id=~\"${connector:regex}\",connector_action=~\"${action:regex}\"}[$__range]))) >= 0"
        }
      ],
      "id": 14
    },
    {
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "panels": [],
      "id": 15
    },
    {
      "type": "logs",
      "title": "Logs",
      "description": "Filter with the trace_id and search boxes above. Expand a line for its fields (error_code, error_category, audit_event, tenant_id, action).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range",
          "expr": "{service_name=~\"${service:regex}\"} | connector_id=~\"${connector:regex}\" | action=~\"${action:regex}\" | trace_id=~\"${trace_id}.*\" |~ \"(?i)${search}\""
        }
      ],
      "id": 16
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "node-wire"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service_name",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "description": "OpenTelemetry service.name: node-wire (REST/MCP), nw-<connector> (nw-mcp-builder hosts), <server>-mcp (stacklok servers)"
      },
      {
        "name": "connector",
        "label": "Connector",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(connector_invocations_total{service_name=~\"${service:regex}\"}, connector_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "description": "",
        "allValue": ".*"
      },
      {
        "name": "action",
        "label": "Action",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(connector_invocations_total{service_name=~\"${service:regex}\",connector_id=~\"${connector:regex}\"}, connector_action)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "description": "The invoked connector action (connector_action metric label, action log field).",
        "allValue": ".*"
      },
      {
        "name": "trace_id",
        "label": "trace_id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Paste the trace_id from a tool error to see that call's log lines."
      },
      {
        "name": "search",
        "label": "Search logs",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Connector Calls & Logs",
  "uid": "connector_logs_fixed",
  "version": 1,
  "weekStart": ""
}
