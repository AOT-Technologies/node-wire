# Secret — bearer token for {{ server_name }} upstream API.
#
# Replace the token value with your actual API key / bearer token.
# Namespace must match the MCPExternalAuthConfig and MCPServer.
#
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ server_name }}-secret
  namespace: {{ namespace }}
type: Opaque
stringData:
  token: REPLACE_ME
